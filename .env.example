# =============================================================
# GeoVision — Environment Variables Template
# =============================================================
#
# HOW TO USE THIS FILE:
#   1. Make a COPY of this file and name the copy exactly:  .env
#   2. Open your new .env file
#   3. Replace the placeholder values below with your REAL keys
#   4. NEVER share .env or commit it to GitHub
#
# The .gitignore file already protects .env from being uploaded.
# This file (.env.example) is safe to share — it has no real secrets.
#
# =============================================================


# --- Mapillary API -------------------------------------------
# How to get your token:
#   1. Go to https://www.mapillary.com/
#   2. Create a free account
#   3. Visit https://www.mapillary.com/dashboard/developers
#   4. Create a new application and copy the "Client Token"
#   5. Paste it below (replacing the placeholder text)

MAPILLARY_CLIENT_TOKEN=your_mapillary_client_token_here


# --- (Future) Other API Keys ---------------------------------
# Add more keys here as the project grows.
# Example format:
#   SOME_OTHER_API_KEY=your_key_here

